    {"label": "two-rounds", "args": ["2", "2"], "expect": {"returncode": 0, "stdout": "8524\n"}},
    {"label": "three-rounds", "args": ["2", "3"], "expect": {"returncode": 0, "stdout": "286752\n"}},
    {"label": "negative-seed", "args": ["-3", "2"], "expect": {"returncode": 0, "stdout": "4500\n"}},
    {"label": "int-min-seed", "args": ["-2147483648", "2"], "expect": {"returncode": 0, "stdout": "-68719473412\n"}},
    {"label": "int-max-seed", "args": ["2147483647", "3"], "expect": {"returncode": 0, "stdout": "-2132451227355\n"}},
    {"label": "larger", "args": ["100", "4"], "expect": {"returncode": 0, "stdout": "259783170\n"}},
    {"label": "usage-missing-arg", "args": ["5"], "expect": {"returncode": 2, "stdout": ""}},
